    "packageManager": "pnpm@12.0.0-rc.7+sha512.1d967069e7bb40beea4e2ebb5f4d6cfaab099119593cd2bfd26516f4c6e151a387d9b3a205f8d629264d6bd764b35e5bfdb38fa9cf798e625203353bc6fbb254"
